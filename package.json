{
  "name": "lunarsafe",
  "private": true,
  "version": "1.0.0",
  "description": "Autonomous Lunar Landing-Site Hazard Assessment Platform",
  "author": "Team Rocket · Parul University",
  "type": "module",
  "main": "main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node -e \"fs.cpSync('src/assets/samples', 'dist/src/assets/samples', {recursive: true})\" && esbuild server.ts --bundle --platform=node --format=cjs --outfile=dist/server.cjs --packages=external",
    "start": "node dist/server.cjs",
    "serve": "npm run build && npm run start",
    "lint": "tsc --noEmit",
    "server": "tsx server.ts",
    "test:determinism": "tsx tests/determinism.test.ts",
    "test:gsd": "tsx tests/gsdGrid.test.ts",
    "test:dem": "tsx tests/demSlope.test.ts",
    "test:groundtruth": "tsx tests/groundTruth.test.ts",
    "test:uncertainty": "tsx tests/uncertainty.test.ts",
    "test:hazardconservative": "tsx tests/hazardConservative.test.ts",
    "test:marginal": "tsx tests/marginalSite.test.ts",
    "test:agentom": "tsx tests/agentOm.test.ts",
    "test:comparison": "tsx tests/comparisonEngine.test.ts",
    "test:workflow": "tsx tests/workflowSelector.test.ts",
    "test:security": "tsx tests/security.test.ts",
    "test:multiSiteValidation": "tsx tests/multiSiteValidation.test.ts"
  },
  "dependencies": {
    "@types/three": "^0.186.0",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "form-data": "^4.0.6",
    "jpeg-js": "^0.4.4",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.441.0",
    "pngjs": "^7.0.0",
    "puppeteer-core": "^24.43.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.2",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@noble/hashes": "1.8.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.4",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.5",
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.64.1",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.11",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.3",
    "wait-on": "^9.5.1"
  },
  "overrides": {
    "@noble/hashes": "1.8.0"
  }
}
